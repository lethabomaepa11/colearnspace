{
	"name": "colearnspace",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check src scripts tests docs package.json vite.config.ts && eslint src scripts tests vite.config.ts",
		"db:migrate": "node scripts/migrate.mjs",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"db:platform": "node scripts/migrate-platform.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
		"svelte": "^5.0.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@lucide/svelte": "^0.494.0",
		"@neondatabase/serverless": "^1.2.0",
		"better-auth": "^1.7.15",
		"pg": "^8.23.1"
	},
	"engines": {
		"node": ">=24 <27"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"deepmerge": "^4.3.1",
		"minimatch": "^11.0.4",
		"glob": "^14.0.3"
	}
}
